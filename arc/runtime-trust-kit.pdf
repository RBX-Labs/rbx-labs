%PreformattedPara
.086275 .133333 .121569 rg
BT 1 0 0 1 0 586.6 Tm /F3 6.8 Tf 8.6 TL (  assert.ok\(signal in policy.required_signals, `policy is missing ${signal}`\);) Tj T* (  assert.ok\(signal in runtimeAware.observed_signals, `runtime trace is missing ${signal}`\);) Tj T* (}) Tj T*  T* (for \(const trace of [promptOnly, runtimeAware]\) {) Tj T* (  for \(const field of [) Tj T* (    'runtime_outcome',) Tj T* (    'human_disposition',) Tj T* (    'accountable_rationale',) Tj T* (    'execution_acknowledgement',) Tj T* (    'observed_effect') Tj T* (  ]\) {) Tj T* (    assert.ok\(field in trace, `${trace.trace_id} is missing ${field}`\);) Tj T* (  }) Tj T* (  assert.ok\(!\('decision' in trace\), `${trace.trace_id} must not collapse lifecycle state into) Tj T* (    decision`\);) Tj T* (  assert.ok\(!\('rationale' in trace.human_disposition\), `${trace.trace_id} must keep accountable) Tj T* (    rationale separate from human disposition`\);) Tj T* (  assert.notStrictEqual\(trace.human_disposition, trace.accountable_rationale\);) Tj T* (}) Tj T*  T* (assert.equal\(runtimeAware.schema_version, '0.3.0'\);) Tj T* (assert.equal\(evaluation.expected.runtime_outcome, 'needs_maintainer_review'\);) Tj T* (assert.equal\(evaluation.expected.human_disposition, 'pending'\);) Tj T* (assert.equal\(evaluation.expected.accountable_rationale, 'pending'\);) Tj T* (assert.equal\(runtimeAware.runtime_outcome, 'needs_maintainer_review'\);) Tj T* (assert.equal\(runtimeAware.human_disposition.status, 'pending'\);) Tj T* (assert.equal\(runtimeAware.human_disposition.owner, 'maintainer'\);) Tj T* (assert.notEqual\(runtimeAware.human_disposition.status, 'approved', 'Pending human review must) Tj T* (not be represented as approval.'\);) Tj T* (assert.equal\(runtimeAware.accountable_rationale.status, 'pending'\);) Tj T* (assert.equal\(runtimeAware.accountable_rationale.reason, null\);) Tj T* (assert.equal\(runtimeAware.execution_acknowledgement.status, 'not_attempted'\);) Tj T* (assert.equal\(runtimeAware.observed_effect.status, 'not_observed'\);) Tj T* (assert.equal\(runtimeAware.observed_effect.independently_verified, false\);) Tj T* (assert.equal\(promptOnly.mode, 'prompt_only'\);) Tj T* (assert.equal\(promptOnly.runtime_outcome, 'approved', 'The fixture must preserve the unsafe) Tj T* (prompt-only approval for comparison.'\);) Tj T* (assert.equal\(promptOnly.human_disposition.status, 'not_recorded'\);) Tj T* (assert.equal\(promptOnly.accountable_rationale.status, 'not_recorded'\);) Tj T* (assert.equal\(promptOnly.execution_acknowledgement.status, 'not_attempted'\);) Tj T* (assert.equal\(promptOnly.observed_effect.status, 'not_observed'\);) Tj T* (assert.equal\(promptOnly.observed_effect.independently_verified, false\);) Tj T* (assert.ok\(promptOnly.why_this_is_not_trustworthy.length > 0, 'Prompt-only approval must be) Tj T* (explicitly marked as unsafe.'\);) Tj T* (assert.equal\(runtimeAware.observed_signals.source_conflict, 'unresolved'\);) Tj T* (assert.equal\(runtimeAware.observed_signals.tool_scope, 'within_policy'\);) Tj T*  T* (const acknowledgementOnly = structuredClone\(runtimeAware\);) Tj T* (acknowledgementOnly.execution_acknowledgement = {) Tj T* (  status: 'succeeded',) Tj T* (  receipt: 'transport-acknowledgement-only') Tj T* (};) Tj T* (assert.equal\() Tj T* (  hasIndependentlyObservedEffect\(acknowledgementOnly\),) Tj T* (  false,) Tj T* (  'A success acknowledgement must not satisfy observed-effect verification.') Tj T* (\);) Tj T*  T* (const independentlyObserved = structuredClone\(acknowledgementOnly\);) Tj T* (independentlyObserved.observed_effect = {) Tj T* (  ...independentlyObserved.observed_effect,) Tj T* (  status: 'observed',) Tj T* (  evidence: { artifact: 'feature-x-4.2-adapter-result.json' },) Tj T* (  independently_verified: true) Tj T* (};) Tj T* (assert.equal\(hasIndependentlyObservedEffect\(independentlyObserved\), true\);) Tj T*  T* (console.log\('Runtime Trust Kit contract checks passed.'\);) Tj T* ET
Q
 

