BT 1 0 0 1 0 285.6 Tm /F3 6.8 Tf 8.6 TL (import assert from 'node:assert/strict';) Tj T* (import { readFile } from 'node:fs/promises';) Tj T* (import { fileURLToPath } from 'node:url';) Tj T*  T* (const here = new URL\('../', import.meta.url\);) Tj T* (const readJson = async \(relativePath\) =>) Tj T* (  JSON.parse\(await readFile\(new URL\(relativePath, here\), 'utf8'\)\);) Tj T*  T* (const policy = await readJson\('policy/runtime-policy.example.json'\);) Tj T* (const evaluation = await readJson\('evals/feature-x-upgrade.json'\);) Tj T* (const promptOnly = await readJson\('traces/prompt-only-run.json'\);) Tj T* (const runtimeAware = await readJson\('traces/runtime-aware-run.json'\);) Tj T*  T* (const hasIndependentlyObservedEffect = \(trace\) =>) Tj T* (  trace.observed_effect.status === 'observed' &&) Tj T* (  trace.observed_effect.independently_verified === true &&) Tj T* (  Boolean\(trace.observed_effect.evidence\);) Tj T*  T* (assert.equal\(policy.action.authority, 'read_only'\);) Tj T* (assert.equal\(policy.post_action_verification.required, true\);) Tj T* (assert.equal\(policy.post_action_verification.execution_acknowledgement.satisfies_proof, false\);) Tj T* (assert.equal\(policy.post_action_verification.observed_effect.required_for_completion, true\);) Tj T* (assert.equal\(policy.post_action_verification.observed_effect.requires_independent_verification, true\);) Tj T* (assert.equal\(policy.human_disposition.required_for_authorized_action, true\);) Tj T* (assert.equal\(policy.accountable_rationale.required_for_closure, true\);) Tj T* (assert.equal\(policy.accountable_rationale.record_separately_from_human_disposition, true\);) Tj T* (assert.equal\(policy.fallback.outcome, 'needs_maintainer_review'\);) Tj T*  T* (for \(const signal of [) Tj T* (  'retrieval_coverage',) Tj T* (  'source_freshness_days',) Tj T* (  'source_conflict',) Tj T* (  'tool_scope') Tj T* (]\) {) Tj T* ET
