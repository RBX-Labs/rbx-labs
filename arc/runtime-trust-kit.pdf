BT 1 0 0 1 0 569.4 Tm /F3 6.8 Tf 8.6 TL ({) Tj T* (  "$schema": "https://json-schema.org/draft/2020-12/schema",) Tj T* (  "policy_id": "maintainer-assistant-feature-x-v1",) Tj T* (  "intent": "Answer a maintainer's question about a requested migration without applying a) Tj T* (    repository change.",) Tj T* (  "action": {) Tj T* (    "name": "provide_migration_guidance",) Tj T* (    "authority": "read_only",) Tj T* (    "disallowed": [) Tj T* (      "merge_pull_request",) Tj T* (      "change_production_configuration",) Tj T* (      "publish_release",) Tj T* (      "claim_compatibility_without_evidence") Tj T* (    ]) Tj T* (  },) Tj T* (  "required_signals": {) Tj T* (    "retrieval_coverage": {) Tj T* (      "minimum": 0.8,) Tj T* (      "meaning": "The response is grounded in the issue, migration guide, and compatibility record.") Tj T* (    },) Tj T* (    "source_freshness_days": {) Tj T* (      "maximum": 90,) Tj T* (      "meaning": "Key source material is recent enough for the stated version.") Tj T* (    },) Tj T* (    "source_conflict": {) Tj T* (      "must_be": "resolved_or_escalated",) Tj T* (      "meaning": "Contradictory sources are never silently averaged away.") Tj T* (    },) Tj T* (    "tool_scope": {) Tj T* (      "must_be": "within_policy",) Tj T* (      "meaning": "Every tool call stays inside the named authority boundary.") Tj T* (    }) Tj T* (  },) Tj T* (  "decision_rules": [) Tj T* (    {) Tj T* (      "when": "all_required_signals_pass",) Tj T* (      "outcome": "provide_grounded_guidance",) Tj T* (      "record": ["sources", "signal_values", "policy_id", "model_lock"]) Tj T* (    },) Tj T* (    {) Tj T* (      "when": "source_conflict_is_unresolved OR retrieval_coverage_below_minimum OR) Tj T* (            source_freshness_exceeds_maximum",) Tj T* (      "outcome": "needs_maintainer_review",) Tj T* (      "record": ["blocking_signals", "sources_consulted", "unanswered_question"]) Tj T* (    },) Tj T* (    {) Tj T* (      "when": "requested_action_exceeds_authority",) Tj T* (      "outcome": "refuse_and_route_to_approval",) Tj T* (      "record": ["requested_action", "authority_boundary", "approval_route"]) Tj T* (    }) Tj T* (  ],) Tj T* (  "post_action_verification": {) Tj T* (    "required": true,) Tj T* (    "execution_acknowledgement": {) Tj T* (      "record_separately": true,) Tj T* (      "satisfies_proof": false) Tj T* (    },) Tj T* (    "observed_effect": {) Tj T* (      "required_for_completion": true,) Tj T* (      "requires_independent_verification": true,) Tj T* (      "proof": "Observe the expected downstream state independently; do not accept a tool-success) Tj T* (            response as proof of completion.") Tj T* (    },) Tj T* (    "on_failure": "needs_maintainer_review") Tj T* (  },) Tj T* (  "human_disposition": {) Tj T* (    "required_for_authorized_action": true,) Tj T* ET
